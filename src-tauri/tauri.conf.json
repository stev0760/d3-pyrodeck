{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pyrodeck",
  "version": "0.5.3",
  "identifier": "dev.pyrodeck",
  "build": {
    "frontendDist": "../packages/client/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "D3 Pyrodeck",
        "width": 1280,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "url": "about:blank"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/pyrodeck-server"]
  }
}
