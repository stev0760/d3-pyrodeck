# Admin password for the web panel.
# Option 1: Set this env var (takes precedence over config file)
# PYRODECK_ADMIN_PASSWORD=yourpassword
#
# Option 2: Skip this and set the password via the web UI on first run.
# Pyrodeck will store the hash in config/pyrodeck.json.

# Optional: web server port (default 3001)
# PYRODECK_PORT=3001
