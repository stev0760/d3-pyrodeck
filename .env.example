# Admin password for the web panel.
# Option 1: Set this env var (takes precedence over config file)
# PYRODECK_ADMIN_PASSWORD=yourpassword
#
# Option 2: Skip this and set the password via the web UI on first run.
# Pyrodeck will store the hash in config/pyrodeck.json.

# Optional: web server port (default 3001)
# PYRODECK_PORT=3001

# Optional: address to listen on (default 127.0.0.1, this machine only).
# 0.0.0.0 serves a LAN directly; behind a reverse proxy, leave it unset.
# PYRODECK_HOST=0.0.0.0

# Optional: login sessions end this long after login (hours, default 12)
# or after this long without a request (minutes, default 120).
# PYRODECK_SESSION_TTL_HOURS=12
# PYRODECK_SESSION_IDLE_MINUTES=120

# Optional: game-server log retention, off unless set. Pyrodeck's own logs older
# than this many days are deleted, then the oldest beyond this many MB (0 = off),
# and closed logs are gzipped to .log.gz. These win over the Logs tab; the values
# below suit a public server.
# PYRODECK_LOG_RETENTION_DAYS=30
# PYRODECK_LOG_MAX_MB=2048
# PYRODECK_LOG_COMPRESS=1

# Optional: launch this profile (its exact name, or its id) whenever Pyrodeck
# starts, after re-attaching to a server that kept running, so the game comes
# back after a reboot. Wins over "Start when Pyrodeck starts" in the profile.
# Unset or blank: the UI decides (default: no autostart).
# PYRODECK_AUTOSTART_PROFILE="Public CTF"

# None of the PYRODECK_* variables reach the game server Pyrodeck launches.
